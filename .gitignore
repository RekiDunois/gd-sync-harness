# SQLite state database (local control plane)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak
*.sqlite.bak-*

# Local state/data directories (root-level only, not internal/state source)
/.local/
/state/
/data/

# OAuth credentials and rclone config (never commit secrets)
rclone.conf
**/rclone.conf
credentials.json
client_secret_*.json
token.json
*.credentials.json
*.oauth.json
service-account*.json
*-service-account.json
application_default_credentials.json

# Environment/local override files
.env
.env.*
!.env.example
!.env.sample
*.local.env

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Build artifacts
/bin/
*.exe
*.dylib
*.test
coverage.out

# macOS
.DS_Store

# Logs
*.log
logs/
